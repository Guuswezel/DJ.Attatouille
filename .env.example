# Folder with the music files on the computer that runs Docker Compose.
# It is mounted read-only in the containers at /music.
MUSIC_LIBRARY_PATH=./music

# Leave these unchanged unless the Compose services are moved.
MONGO_URL=mongodb://mongo:27017
QDRANT_URL=http://qdrant:6333
RUST_LOG=info

# Local higher-quality structure/embedding model. It downloads public weights
# once and automatically uses CUDA when Docker has an NVIDIA GPU available.
INSTALL_HARMONIX=true
ANALYSIS_MODEL=harmonix
ANALYSIS_DEVICE=auto
# Fast profile avoids multi-minute full HTDemucs separation during library
# preparation. It keeps beat, phrase, energy, spectrum, and embedding trends
# using a 22.05 kHz proxy. Set `full` only for a deliberate slow, full-stem pass.
HARMONIX_PROFILE=fast
ANALYSIS_SAMPLE_RATE=22050
HARMONIX_PROXY_SAMPLE_RATE=22050
# Leave unset for the normal 8-fold ensemble. MPS defaults to harmonix-fold0
# because loading all eight folds can exceed the unified-memory budget on M2.
# HARMONIX_MODEL=harmonix-all

# Apple Silicon MPS mode (used only with docker-compose.macos.yml): generated
# media is shared with the native worker from this host folder.
DJ_DATA_PATH=./.dj-attatouille-data

# Offline transition-learning data. Put timed tracklists in TRAINING_INPUT_PATH.
# The localizer/critic/trainer are only started explicitly; normal playback
# loads the compact exported policy from DJ_DATA_PATH/models.
TRANSITION_TRAINING_PATH=./.dj-attatouille-training
TRAINING_INPUT_PATH=./training-input
TRANSITION_TRAIN_DEVICE=auto

# Optional local auto-mastering defaults. Tracks are measured with FFmpeg's
# EBU R128 meter and receive a bounded virtual DJ gain trim before rendering.
DJ_TARGET_LUFS=-14
DJ_MAX_TRIM_DB=8
MASTER_TARGET_DBFS=-14
MASTER_CEILING_DBFS=-1
